### 9.2 Reference Model Comparison

```python
print("\n" + "=" * 60)
print("9.2 Comparison with NCLLM-Sovereign Reference Model")
print("=" * 60)

# Compute deviations from reference
print("Deviations from Reference:")
for domain, crsm in results.items():
    print(f"\n{domain}:")
    for metric in ['Φ', 'Γ', 'Λ', 'Ξ']:
        ref_val = CRSM_REFERENCE[metric]
        obs_val = crsm.to_dict()[metric]
        deviation = abs(obs_val - ref_val)
        rel_deviation = deviation / ref_val if ref_val > 0 else 0
        print(f"  {metric}: {deviation:.6f} ({rel_deviation*100:.2f}%)")

# Overall similarity
print("\nOverall Similarity to Reference:")
for domain, crsm in results.items():
    deviations = []
    for metric in ['Φ', 'Γ', 'Λ', 'Ξ']:
        ref_val = CRSM_REFERENCE[metric]
        obs_val = crsm.to_dict()[metric]
        deviations.append(abs(obs_val - ref_val) / ref_val if ref_val > 0 else 0)
    avg_deviation = np.mean(deviations)
    similarity = 1 - avg_deviation
    print(f"  {domain}: {similarity*100:.2f}% similarity")
```

