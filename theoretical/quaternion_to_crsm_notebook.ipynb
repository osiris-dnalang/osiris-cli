### 6.3 Structural Similarity Analysis

```python
print("\n" + "=" * 60)
print("6.3 Structural Similarity Analysis")
print("=" * 60)

# Compute pairwise differences
metrics_list = ['Φ', 'Γ', 'Λ', 'Ξ', 'fidelity']
domains = ['Physics', 'Egyptology', 'Computation']

# Create similarity matrix
similarity = np.zeros((len(domains), len(domains)))
for i, d1 in enumerate(domains):
    for j, d2 in enumerate(domains):
        diffs = []
        for m in metrics_list:
            v1 = all_crsm[d1].to_dict()[m]
            v2 = all_crsm[d2].to_dict()[m]
