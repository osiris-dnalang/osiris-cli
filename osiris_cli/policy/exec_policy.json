{
  "policy_version": "exec-policy-1",
  "tiers": {
    "READ":      {"human": "ALLOW", "agent": "ALLOW"},
    "VERIFY":    {"human": "ALLOW", "agent": "ASK_ONCE"},
    "MUTATE":    {"human": "ASK",   "agent": "ASK"},
    "NETWORK":   {"human": "ASK",   "agent": "DENY"},
    "FORBIDDEN": {"human": "DENY",  "agent": "DENY"}
  },
  "shell_operator_tokens": ["|", "||", "&", "&&", ";", ">", ">>", "<", "<<", "<>", "2>", "2>&1", "&>", "|&"],
  "shell_substitution_markers": ["$(", "`", "<(", ">("],
  "shells": ["bash", "sh", "dash", "zsh", "fish", "ksh", "csh", "tcsh"],
  "opaque_builtins": ["eval", "source", "."],
  "forbidden_programs": ["sudo", "su", "doas", "pkexec", "printenv"],
  "launcher_programs": ["xargs", "env"],
  "read_programs": ["ls", "cat", "head", "tail", "wc", "uniq", "cut", "jq", "rg", "grep", "pwd", "which"],
  "read_with_output_guard": {"sort": ["-o", "--output"]},
  "verify_programs": ["pytest", "mypy"],
  "python_verify_modules": ["pytest", "compileall"],
  "ruff_verify_subcommands": ["check"],
  "ruff_fix_prefixes": ["--fix", "--add-noqa"],
  "network_programs": ["curl", "wget", "ssh", "scp", "rsync"],
  "network_scripts": ["run_ibm.py"],
  "verify_scripts": ["verify_ledger.py"],
  "publish_script_patterns": ["publish_*_to_zenodo.py", "create_release.py"],
  "publish_flags": ["--publish"],
  "delete_programs": ["rm", "rmdir", "shred", "dd", "mkfs*"],
  "mode_programs": ["chmod", "chown"],
  "mode_recursive_flags": ["-R", "--recursive"],
  "find_exec_flags": ["-exec", "-execdir", "-ok", "-okdir", "-delete"],
  "find_exec_prefixes": ["-fprint"],
  "pip_read_subcommands": ["list", "show", "freeze", "--version", "-V"],
  "python_inline_flag_regex": "^-[A-Za-z]*c[A-Za-z]*$",
  "python_value_flags": ["-W", "-X", "-Q"],
  "inline_flag_patterns": {
    "node": ["^-e$", "^--eval$", "^-p$", "^--print$"],
    "perl": ["^-[A-Za-z]*[eE]"],
    "ruby": ["^-[A-Za-z]*e"],
    "php": ["^-[A-Za-z]*r$"]
  },
  "ollama_network_subcommands": ["pull"],
  "gcloud_sensitive_args": ["print-access-token"],
  "git": {
    "read": ["status", "diff", "log", "show", "blame", "rev-parse", "ls-files"],
    "network": ["fetch", "pull", "clone", "ls-remote"],
    "write": ["add", "commit", "rebase", "merge", "cherry-pick", "revert", "tag", "push", "reset",
              "clean", "stash", "checkout", "switch", "restore", "rm", "mv", "worktree", "am",
              "apply", "init", "config"],
    "stash_read": ["list", "show"],
    "denied_config_keys": ["alias.*", "core.sshcommand", "core.pager", "core.editor",
                           "core.fsmonitor", "core.hookspath", "credential.helper", "protocol.*"],
    "global_value_options": ["-C", "--git-dir", "--work-tree", "--namespace"],
    "global_flag_options": ["--no-pager", "-P", "--bare", "--no-replace-objects", "--literal-pathspecs"],
    "branch_list_flags": ["-a", "-r", "-v", "-vv", "--all", "--remotes", "--verbose", "--list", "-l",
                          "--show-current"],
    "branch_list_value_flags": ["--contains", "--merged", "--no-merged"],
    "branch_list_prefixes": ["--format=", "--sort="],
    "diff_verify_flags": ["--check"],
    "diff_output_prefixes": ["--output"]
  },
  "gh_read": {
    "pr": ["view", "list", "status", "checks", "diff"],
    "issue": ["view", "list", "status"],
    "run": ["list", "view"],
    "repo": ["view"],
    "release": ["list", "view"],
    "auth": ["status"]
  },
  "wrappers": {
    "timeout": {"value_options": ["-s", "-k", "--signal", "--kill-after"], "positionals": 1},
    "nice": {"value_options": ["-n", "--adjustment"], "positionals": 0},
    "ionice": {"value_options": ["-c", "-n", "-p", "-P", "-u", "--class", "--classdata"], "positionals": 0},
    "stdbuf": {"value_options": ["-i", "-o", "-e"], "positionals": 0},
    "nohup": {"value_options": [], "positionals": 0},
    "time": {"value_options": ["-f", "-o", "--format", "--output"], "positionals": 0},
    "command": {"value_options": [], "positionals": 0}
  },
  "max_wrapper_depth": 8,
  "secrets": {
    "name_regex": "^\\.env(\\..+)?$|^.+\\.env(\\.txt)?$",
    "path_sequences": [[".ssh"], [".aws"], [".gnupg"], [".config", "gcloud"], [".config", "gh"]],
    "names": [".netrc", ".git-credentials"],
    "dir_names": ["keyrings"],
    "suffixes": [".pem", ".key"],
    "service_account_regex": "(?i)service[-_]account.*\\.json$"
  },
  "ledger_regex": "(?i)ledger[^/]*\\.(db|sqlite3?)$",
  "env": {
    "allow": ["PATH", "HOME", "USER", "LOGNAME", "LANG", "TERM", "TZ", "TMPDIR", "VIRTUAL_ENV",
              "CONDA_PREFIX", "PREFIX", "ANDROID_ROOT", "ANDROID_DATA", "CUDA_VISIBLE_DEVICES",
              "OMP_NUM_THREADS", "PYTHONPATH"],
    "allow_prefixes": ["LC_", "OSIRIS_"],
    "deny_regex": "(?i)token|secret|passw|api[_-]?key|private[_-]?key|credential|cookie|session|dsn|_url$",
    "deny_names": ["QISKIT_IBM_TOKEN", "GOOGLE_APPLICATION_CREDENTIALS", "HF_TOKEN", "GH_TOKEN",
                   "GITHUB_TOKEN", "ZENODO_TOKEN", "OSIRIS_PG_URL"],
    "deny_globs": ["IBM_*KEY*", "*_API_KEY", "AWS_*"]
  },
  "output": {"head_chars": 4000, "tail_chars": 4000, "artifact_max_bytes": 33554432},
  "grant_ttl_s": 60,
  "kill_grace_s": 2.0
}
